# Portfolio AI Assistant Environment Variables
# Copy this file to .env and fill in your API keys

# DeepSeek API Key (for LLM response generation)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Pinecone Vector DB Configuration (for RAG context retrieval)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_HOST=https://your-pinecone-index-host.svc.pinecone.io

# (Optional) Upstash Redis Configuration (for rate limiting and response caching)
# UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# (Optional) Cloudflare Turnstile Verification
# TURNSTILE_SECRET_KEY=your_turnstile_secret_key
# VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
