{
  "name": "portfolio-backend",
  "version": "1.0.0",
  "description": "Vercel Serverless RAG backend for Abeer Ahmed's portfolio AI assistant",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "vercel dev --listen 3001",
    "ingest": "tsx scripts/ingest.ts",
