    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/node": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.0",
    "vercel": "^58.7.1"
  }
}
